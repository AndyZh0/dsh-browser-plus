<Project Sdk="Microsoft.NET.Sdk">

  <!--
    dsh-browser-plus WebView2 host.

    This replaces the Electron main process (host-main.ts). It is spawned by
    RemoteElectronViewHost exactly like the Electron child was: the parent
    listens on an ephemeral loopback port, passes the rpc port flag, and the host
    connects back and speaks one JSON object per line.

    Framework-dependent on net8.0-windows: the WebView2 Runtime is a machine
    prerequisite (Evergreen), and the .NET 8 WindowsDesktop runtime is required
    at run time. A self-contained publish (dotnet publish with the
    self-contained flag) produces a dependency-free build for distribution.
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>dsh-browser-plus-host</AssemblyName>
    <RootNamespace>DshBrowserPlusHost</RootNamespace>
    <LangVersion>12</LangVersion>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <!-- The WPF assembly of the WebView2 package drags a WindowsBase version
         conflict warning in; it is never referenced by this WinForms host. -->
    <NoWarn>$(NoWarn);MSB3277</NoWarn>
    <!-- Do not copy the NuGet XML documentation or symbols next to the host:
         they are never read at run time and would add ~800 KiB to the package. -->
    <AllowedReferenceRelatedFileExtensions>none</AllowedReferenceRelatedFileExtensions>
    <DebugType>none</DebugType>
    <!-- This host is WinForms on Windows x64. Pinning the RID makes the SDK
         copy only the x64 WebView2Loader.dll instead of one per Windows
         architecture; AppendRuntimeIdentifierToOutputPath keeps the output at
         bin/Release/net8.0-windows/ so the parent's host lookup stays flat. -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PlatformTarget>x64</PlatformTarget>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2903.40" />
  </ItemGroup>

  <!--
    The WebView2 meta-package ships Core + WinForms + Wpf. The RID pin above
    already drops the non-x64 native loaders and copies the one x64 loader to
    the app root; the package's runtimes/ copy of that same loader is therefore
    a duplicate, and the WPF assembly is referenced by nothing here. Both would
    otherwise sit in the committed output as dead weight (host/bin/Release is
    committed because a github: install fetches the tree and never builds).

    Deleting rather than excluding is deliberate: the package exposes no
    per-assembly switch, and removing the WPF reference does not stop the copy.
    A missing assembly is harmless because nothing in this host requests it; the
    live smoke test exercises the real host to prove that.
  -->
  <Target Name="TrimUnusedWebView2Assets" AfterTargets="Build">
    <ItemGroup>
      <UnusedWebView2 Include="$(OutDir)Microsoft.Web.WebView2.Wpf.dll" />
      <UnusedWebView2 Include="$(OutDir)runtimes/**/*" />
    </ItemGroup>
    <Delete Files="@(UnusedWebView2)" ContinueOnError="true" />
    <RemoveDir Directories="$(OutDir)runtimes" ContinueOnError="true" />
  </Target>

</Project>
